{
  "name": "@free-lzj/dsh-agent-import",
  "version": "0.2.1",
  "description": "Imports the MCP servers and skills that Codex or Claude Code already declares into DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "codex",
    "claude-code",
    "mcp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-mcp-client": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-skill": "^0.1.7-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.4",
    "@deepseek-ai/dsh-app-boot": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-skill": "^0.1.7-alpha.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
