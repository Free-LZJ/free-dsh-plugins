{
  "name": "@free-lzj/dsh-connector-dsh",
  "version": "0.2.0",
  "description": "The built-in DSH connector for the workbench: session creation, delivery to existing sessions, scripts, MCP tools, HTTP, notifications and LLM calls — registered through the same API a third-party connector uses",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Free-LZJ/free-dsh-plugins.git",
    "directory": "packages/connector-dsh"
  },
  "homepage": "https://github.com/Free-LZJ/free-dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/Free-LZJ/free-dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "workbench",
    "connector"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@free-lzj/dsh-decision": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
