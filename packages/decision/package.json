{
  "name": "@free-lzj/dsh-decision",
  "version": "0.1.0",
  "description": "Source-agnostic decision core: a rule file, condition/action registries, hit records and the undo window — a library the connector plugins build on, not a plugin itself",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Free-LZJ/free-dsh-plugins.git",
    "directory": "packages/decision"
  },
  "homepage": "https://github.com/Free-LZJ/free-dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/Free-LZJ/free-dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "decision",
    "rules",
    "triage"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
