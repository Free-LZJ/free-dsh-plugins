{
  "name": "@free-lzj/dsh-web-search-account",
  "version": "0.1.0",
  "description": "Search with the DeepSeek account you are already signed in to, whatever model the conversation runs on, so web search keeps working on a gateway or third-party model route without a separate search API key",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Free-LZJ/free-dsh-plugins.git",
    "directory": "packages/web-search-account"
  },
  "homepage": "https://github.com/Free-LZJ/free-dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/Free-LZJ/free-dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "web-search",
    "deepseek-account"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-web": ">=0.1.7-alpha.2 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
