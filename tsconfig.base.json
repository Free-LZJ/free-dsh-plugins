{
  "compilerOptions": {
    // Workspace libraries resolve to their **sources** for typechecking, so a
    // fresh clone can typecheck before anything has been built. The build
    // configs clear this map and resolve the emitted `.d.ts` instead.
    "paths": {
      "@free-lzj/dsh-decision": ["./packages/decision/src/index.ts"],
      // The workbench contract an adopting plugin's browser half imports.
      // Mapped to the source entry for the same reason as decision above: CI
      // typechecks a fresh checkout before any lib/ exists, and the package
      // export points at the built declaration (lib/types/client/contract-entry.d.ts).
      "@free-lzj/dsh-console/contract": ["./packages/console/src/client/contract-entry.ts"],
      // The built-in connector the workbench registers at startup; its package
      // export also points at the built declaration under lib/.
      "@free-lzj/dsh-connector-dsh": ["./packages/connector-dsh/src/index.ts"]
    },
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  }
}
